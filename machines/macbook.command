#!/bin/sh
# ayamai — MacBook
# Generated by `ayamai bootstrap macbook`. Edit machines/macbook.json, not this file.

set -eu

echo "ayamai — MacBook"

[ "$(uname -s)" = "Darwin" ] || { echo "this is the darwin script; you are on $(uname -s)"; exit 1; }

cd "$(dirname "$0")/.."

# node 20.11 or newer
if command -v node >/dev/null 2>&1 && node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>20||(a===20&&b>=11)?0:1)'; then
  echo "· node 20.11 or newer: ok"
else
  echo "node is missing or older than 20.11. Run ./machines/preflight.command — it names the installer for this macOS (no Xcode needed)."
  exit 1
fi

# pnpm 10
if command -v pnpm >/dev/null 2>&1; then
  echo "· pnpm 10: ok"
else
  echo "pnpm not found. Run: corepack enable && corepack prepare pnpm@10 --activate"
  exit 1
fi

# the workspace
if [ -d node_modules ] && [ ! package.json -nt node_modules ] && [ ! pnpm-lock.yaml -nt node_modules ]; then
  echo "· the workspace: already done"
else
  pnpm install --frozen-lockfile
fi

# the name on this machine (asks for your password once)
if grep -q ayamai.local /etc/hosts 2>/dev/null; then
  echo "· the name on this machine (asks for your password once): already done"
else
  node packages/cli/index.mjs install
fi

# the platform
node packages/cli/index.mjs up

# the check
node packages/cli/index.mjs doctor

echo ""
echo "ayamai is up — http://ayamai.local"
