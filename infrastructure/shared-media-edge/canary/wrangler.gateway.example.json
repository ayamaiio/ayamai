{
  "name": "ayamai-edge-canary",
  "account_id": "53dcf89689e1f019f32eacc9be31cd6b",
  "main": "gateway.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "CANARY_ONLY": "synthetic-v1", "CANARY_BUCKET": "ayamai-edge-canary" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ayamai-edge-canary" }],
  "services": [{ "binding": "AUTHORITY", "service": "ayamai-edge-canary-api" }],
  "assets": { "directory": "./harness", "binding": "ASSETS", "run_worker_first": true }
}
