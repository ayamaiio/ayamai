{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:edge-authorization": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/scripts/benchmark-edge-authorization.mjs",
    "benchmark:shared-delivery": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/scripts/benchmark-shared-delivery.mjs",
    "benchmark:previews": "node scripts/benchmark-previews.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@clerk/express": "^2.1.85",
    "@clerk/shared": "^4.43.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "http-proxy-middleware": "^4.2.1",
    "ipaddr.js": "^2.5.0",
    "megajs": "^1.3.10",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "thread-stream": "3.1.0"
  }
}
