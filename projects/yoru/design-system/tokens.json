      },
      "successForeground": {
        "$value": "{color.light.primaryForeground}"
      },
      "warning": {
        "$value": "{color.light.chart4}",
        "$description": "Warning feedback; shares the existing subdued amber."
      },
      "warningForeground": {
        "$value": "{color.light.primaryForeground}"
      },
      "overlay": {
        "$value": "{color.dark.background}",
        "$description": "Deep Void scrim, including the light theme."
      }
