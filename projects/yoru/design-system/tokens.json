      "warning": {
        "$value": "{color.dark.chart4}",
        "$description": "Warning feedback; shares the existing subdued amber."
      },
      "warningForeground": {
        "$value": "{color.dark.background}"
      },
      "overlay": {
        "$value": "{color.dark.background}",
        "$description": "Deep Void scrim, including the light theme."
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "sans-serif"
        ],
        "$description": "Default UI and body typeface."
      },
      "serif": {
        "$value": [
          "Inter",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "monospace"
        ]
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
