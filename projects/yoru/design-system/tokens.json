      "chart4": {
        "$value": "#cead9a"
      },
      "chart5": {
        "$value": "#FF3B5C"
      },
      "sidebar": {
        "$value": "#0B0D14"
      },
      "sidebarForeground": {
        "$value": "#E6ECFF"
      },
      "sidebarBorder": {
        "$value": "#1D2233"
      },
      "sidebarPrimary": {
        "$value": "#A9B7E8"
      },
      "sidebarPrimaryForeground": {
        "$value": "#0B0D14"
      },
      "sidebarAccent": {
        "$value": "#1D2233"
      },
      "sidebarAccentForeground": {
        "$value": "#E6ECFF"
      },
      "sidebarRing": {
        "$value": "#A9B7E8"
      },
      "success": {
        "$value": "{color.dark.chart2}",
        "$description": "Success feedback; shares the existing subdued teal."
      },
      "successForeground": {
        "$value": "{color.dark.background}"
