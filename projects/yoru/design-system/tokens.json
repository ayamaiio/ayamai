{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ayamai North Star v1: Deep Void, EVA Blue, Rei Blue, Pale and a sparse Alert Red. Dark is the product default; light is a derived accessible alternate.",
  "color": {
    "$type": "color",
    "light": {
      "background": {
        "$value": "#f2f1ed"
      },
      "foreground": {
        "$value": "#263450"
