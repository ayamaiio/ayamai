      "chart2": {
        "$value": "#4b686a"
      },
      "chart3": {
        "$value": "#636192"
      },
      "chart4": {
        "$value": "#8c6254"
      },
      "chart5": {
        "$value": "#963e54"
      },
      "sidebar": {
        "$value": "#e8e9ed"
      },
      "sidebarForeground": {
        "$value": "#263450"
